			<finder-column name="status" />
		</finder>
		<finder name="FormVersionId" return-type="Collection">
			<finder-column name="formVersionId" />
		</finder>
		<finder name="C_IK" return-type="Submission" unique="true">
			<finder-column name="campaignId" />
			<finder-column name="idempotencyKey" />
		</finder>
	</entity>

	<entity local-service="true" name="SubmissionValue" remote-service="false">
