	<entity external-reference-code="group" local-service="true" name="Campaign" remote-service="true" uuid="true">
		<column name="campaignId" primary="true" type="long" />

		<column name="groupId" type="long" />
		<column name="companyId" type="long" />
		<column name="userId" type="long" />
		<column name="userName" type="String" />
		<column name="createDate" type="Date" />
		<column name="modifiedDate" type="Date" />

		<column name="name" type="String" />
		<column name="description" type="String" />
		<column name="slug" type="String" />
		<column name="mode" type="String" />
		<column name="status" type="String" />
		<column name="startDate" type="Date" />
		<column name="endDate" type="Date" />
		<column name="submissionLimit" type="int" />
		<column name="seriesKey" type="String" />
		<column name="instanceKey" type="String" />
		<column name="sourceCampaignId" type="long" />
		<column name="retentionDays" type="int" />
		<column name="defaultLanguageId" type="String" />
		<column name="publishedDate" type="Date" />
		<column name="publishedByUserId" type="long" />
		<column name="settings" type="String" />

		<order by="desc">
			<order-column name="modifiedDate" />
		</order>

		<finder name="GroupId" return-type="Collection">
			<finder-column name="groupId" />
		</finder>
		<finder name="G_S" return-type="Campaign" unique="true">
			<finder-column name="groupId" />
			<finder-column name="slug" />
		</finder>
		<finder name="G_St" return-type="Collection">
			<finder-column name="groupId" />
			<finder-column name="status" />
		</finder>
		<finder name="C_SK" return-type="Collection">
			<finder-column name="companyId" />
			<finder-column name="seriesKey" />
		</finder>
	</entity>

	<entity local-service="true" name="CampaignQuota" remote-service="false">
		<column name="campaignId" primary="true" type="long" />

		<column name="companyId" type="long" />
		<column name="used" type="int" />
	</entity>

	<entity local-service="true" name="Form" remote-service="true">
